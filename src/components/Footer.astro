---
// The footer, in the dark forest band: the club, its pages (Gallery and
// Documents are linked here), the contact and the legal pages.
import { localizedPath, t, type Lang } from "../i18n";
import { clubLinks } from "../lib/navigation";
import site from "../site.config";
import EnvironmentBadge from "./EnvironmentBadge.astro";
import Logo from "./Logo.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const legal = [
  { on: site.legalPages.imprint, href: "/imprint", label: t(lang, "legal.imprint") },
  { on: site.legalPages.privacy, href: "/privacy", label: t(lang, "legal.privacy") },
  { on: site.legalPages.accessibility, href: "/accessibility", label: t(lang, "legal.accessibility") },
  { on: site.legalPages.sustainability, href: "/sustainability", label: t(lang, "legal.sustainability") },
  { on: true, href: "/sitemap", label: t(lang, "legal.sitemap") },
].filter((link) => link.on);
const club = clubLinks(lang);
const { company, contact } = site;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap footer-row">
    <div class="footer-about">
      <a class="brand" href={localizedPath(lang)}>
        <Logo size={40} />
        <span>{site.name}</span>
      </a>
      <p>{site.description[lang]}</p>
      <address>
        {`${company.address.street}, ${company.address.postalCode} ${company.address.city}`}<br />
        {contact.topics.map(({ email }) => <a href={`mailto:${email}`}>{email}</a>)}
      </address>
      <p>{t(lang, "footer.noCookies")}</p>
    </div>
    <nav aria-label={t(lang, "footer.club")}>
      <p class="footer-heading">{t(lang, "footer.club")}</p>
      <ul class="footer-links">
        {
          club.map(({ href, label }) => (
            <li>
              <a href={localizedPath(lang, href)}>{label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <nav aria-label={t(lang, "legal.nav")}>
      <p class="footer-heading">{t(lang, "legal.nav")}</p>
      <ul class="footer-links">
        {
          legal.map(({ href, label }) => (
            <li>
              <a href={localizedPath(lang, href)}>{label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
  <div class="wrap footer-bottom">
    <span>© {year} {company.legalName}. {t(lang, "footer.rights")}</span>
    <EnvironmentBadge />
  </div>
</footer>
