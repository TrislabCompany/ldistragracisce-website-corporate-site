---
// A way in: a photo card with its title and one sentence on a dark panel that the photo fades into.
// The whole card is the link's target.
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { photoQuality } from "../lib/photos";

interface Props {
  photo: ImageMetadata;
  alt: string;
  title: string;
  text: string;
  href: string;
}

const { photo, alt, title, text, href } = Astro.props;
---

<li class="photo-frame photo-card">
  <Image src={photo} alt={alt} width={800} height={450} widths={[480, 800]} sizes="(min-width: 52rem) 33vw, 100vw" format="avif" quality={photoQuality.card} loading="lazy" />
  <div class="photo-fade" aria-hidden="true"></div>
  <div class="photo-text photo-content">
    <h3><a href={href}>{title}</a></h3>
    <p>{text}</p>
  </div>
</li>
