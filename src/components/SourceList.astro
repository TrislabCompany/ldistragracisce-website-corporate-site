---
// The sources a page's facts come from, as links at the foot of the page.
interface Props {
  heading: string;
  sources: { label: string; url: string }[];
}

const { heading, sources } = Astro.props;
---

<aside class="sources" aria-label={heading}>
  <h2>{heading}</h2>
  <ul>
    {
      sources.map(({ label, url }) => (
        <li>
          <a href={url} rel="noopener noreferrer">
            {label}
          </a>
        </li>
      ))
    }
  </ul>
</aside>
