---
// The rest of the hunting-tourism page after its offers: the season table,
// what a visiting hunter needs and the permit for hunting guests, the referent
// to call, and the sources.
import { t, type Lang } from "../i18n";
import type { PageTexts } from "../lib/pages";
import site from "../site.config";
import SeasonTable from "./SeasonTable.astro";
import SourceList from "./SourceList.astro";
import TextSections from "./TextSections.astro";
import TourismContact from "./TourismContact.astro";

interface Props {
  lang: Lang;
  texts: PageTexts;
}

const { lang, texts } = Astro.props;
const { huntingTourism: tourism } = texts;
---

<!-- No aria-labelledby here: the season table's own region already carries this name. -->
<section class="section">
  <div class="wrap prose">
    <h2 id="seasons">{tourism.seasonsHeading}</h2>
    <p>{tourism.seasonsIntro}</p>
    <SeasonTable caption={tourism.seasonsHeading} columns={tourism.seasonColumns} seasons={tourism.seasons} />
  </div>
</section>

<section class="section" aria-labelledby="needs">
  <div class="wrap prose">
    <h2 id="needs">{tourism.needsHeading}</h2>
    <ul class="checklist">
      {tourism.needs.map((need) => <li>{need}</li>)}
    </ul>
    <TextSections sections={[tourism.permit]} />
  </div>
</section>

<section class="section section-band on-dark" aria-labelledby="enquire">
  <div class="wrap prose">
    <h2 id="enquire">{tourism.enquireHeading}</h2>
    <p>{tourism.enquireText}</p>
    <div class="actions">
      {site.contact.topics.map(({ email }) => <a class="button light" href={`mailto:${email}`}>{t(lang, "cta.enquire")}</a>)}
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap prose">
    <TourismContact lang={lang} texts={texts.tourismContact} />
    <SourceList heading={texts.sourcesHeading} sources={tourism.sources} />
  </div>
</section>
