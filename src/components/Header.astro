---
// The header: the club's badge and name, the menu and the language switch.
// On a wide screen the menu is a row of links; on a phone it folds into a
// <details> menu that opens without JavaScript. On the home page the header
// lies over the hero photo (overlay).
import { localizedPath, t, type Lang } from "../i18n";
import { mainLinks } from "../lib/navigation";
import site from "../site.config";
import LanguageSwitch from "./LanguageSwitch.astro";
import Logo from "./Logo.astro";

interface Props {
  lang: Lang;
  path: string;
  available?: readonly Lang[];
  overlay?: boolean;
}

const { lang, path, available, overlay = false } = Astro.props;
const links = mainLinks(lang);
// A section's link stays marked on its detail pages (/hunting-tourism/roe-deer).
const current = (href: string) => (href === "/" ? path === "/" : path === href || path.startsWith(`${href}/`));
---

<header class:list={["site-header", { overlay }]}>
  <div class="wrap header-row">
    <a class="brand" href={localizedPath(lang)}>
      <Logo />
      <span>{site.name}</span>
    </a>
    <div class="header-tools">
      <details class="nav-mobile">
        <summary>{t(lang, "nav.menu")}</summary>
        <nav aria-label={t(lang, "nav.main")}>
          {
            links.map(({ href, label }) => (
              <a href={localizedPath(lang, href)} aria-current={current(href) ? "page" : undefined}>
                {label}
              </a>
            ))
          }
        </nav>
      </details>
    </div>
  </div>
  <div class="wrap header-row header-nav-row">
    <nav class="nav-desktop" aria-label={t(lang, "nav.main")}>
      {
        links.map(({ href, label }) => (
          <a href={localizedPath(lang, href)} aria-current={current(href) ? "page" : undefined}>
            {label}
          </a>
        ))
      }
    </nav>
    <div class="header-tools">
      <LanguageSwitch lang={lang} path={path} available={available} />
    </div>
  </div>
</header>
