---
// The head of a page: a wide photo with the page's title and lead on a dark
// panel that the photo fades into. With hero, the home page's full-screen
// version, with buttons in the slot.
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { photoQuality, wideWidths } from "../lib/photos";

interface Props {
  photo: ImageMetadata;
  alt: string;
  title: string;
  lead: string;
  eyebrow?: string;
  hero?: boolean;
}

const { photo, alt, title, lead, eyebrow, hero = false } = Astro.props;
---

<section class:list={["photo-frame", hero ? "hero" : "page-head"]}>
  <Image src={photo} alt={alt} widths={wideWidths} sizes="100vw" format="avif" quality={photoQuality.wide} loading="eager" fetchpriority="high" />
  <div class="photo-fade" aria-hidden="true"></div>
  <div class="photo-text">
    <div class="wrap photo-content">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1>{title}</h1>
      <p>{lead}</p>
      <slot />
    </div>
  </div>
</section>
