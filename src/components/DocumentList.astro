---
// The club's documents: title as a link to the file, then file type, size,
// language and where the file comes from.
interface Props {
  documents: { title: string; meta: string; href: string }[];
}

const { documents } = Astro.props;
---

<ul class="documents">
  {
    documents.map(({ title, meta, href }) => (
      <li>
        <a href={href} rel="noopener noreferrer">
          {title}
        </a>
        <span class="meta">{meta}</span>
      </li>
    ))
  }
</ul>
