---
// Contact: the club's e-mail link, the address with a Google Maps link
// (nothing embedded), the referent for hunting tourism with a phone, and the
// officers by role.
import ContactDetails from "../../components/ContactDetails.astro";
import TourismContact from "../../components/TourismContact.astro";
import { languagePaths, t, type Lang } from "../../i18n";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { pageTexts } from "../../lib/pages";

export const getStaticPaths = languagePaths;

const { lang } = Astro.props as { lang: Lang };
const { contact, about, tourismContact } = await pageTexts(lang);
---

<BaseLayout title={t(lang, "contact.title")} description={contact.lead} lang={lang}>
  <h1>{t(lang, "contact.title")}</h1>
  <p class="lead">{contact.lead}</p>
  <div class="contact-grid">
    <div>
      <ContactDetails lang={lang} />
    </div>
    <div class="contact-cards">
      <TourismContact lang={lang} texts={tourismContact} />
      <section class="card" aria-labelledby="officers">
        <h2 id="officers">{contact.officersHeading}</h2>
        <p>{contact.officersText}</p>
        <ul class="checklist">
          {about.officers.map((role) => <li>{role}</li>)}
        </ul>
      </section>
    </div>
  </div>
</BaseLayout>
