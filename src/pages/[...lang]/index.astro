---
// The home page, top to bottom as in docs/brief.md: the hero, the hunting
// ground in numbers, three ways in, hunting tourism in the dark band, two cards
// for local people, and the contact.
import NumbersBand from "../../components/NumbersBand.astro";
import PhotoCard from "../../components/PhotoCard.astro";
import PhotoHead from "../../components/PhotoHead.astro";
import { languagePaths, localizedPath, t, type Lang } from "../../i18n";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { pageTexts } from "../../lib/pages";
import { photos } from "../../lib/photos";
import site, { tourismReferent } from "../../site.config";

export const getStaticPaths = languagePaths;

const { lang } = Astro.props as { lang: Lang };
const texts = await pageTexts(lang);
const { home, alt, huntingTourism } = texts;
const tourismLead = site.collections.find((collection) => collection.id === "hunting-tourism")?.lead[lang];
const { contact, company } = site;
---

<BaseLayout title={site.name} lang={lang} full overlay>
  <PhotoHead photo={photos.hero} alt={alt.hero} title={site.name} lead={home.heroText} hero>
    <div class="actions on-dark">
      <a class="button light" href={localizedPath(lang, "/hunting-tourism")}>{t(lang, "nav.huntingTourism")}</a>
      <a class="button outline-light" href={localizedPath(lang, "/about")}>{t(lang, "nav.about")}</a>
    </div>
  </PhotoHead>

  <section class="section" aria-labelledby="numbers">
    <div class="wrap">
      <h2 id="numbers">{home.numbersHeading}</h2>
      <NumbersBand numbers={home.numbers} source={home.numbersSource} />
    </div>
  </section>

  <section class="section" aria-labelledby="ways">
    <div class="wrap">
      <h2 id="ways">{home.waysHeading}</h2>
      <ul class="photo-cards">
        <PhotoCard
          photo={photos.huntingGround}
          alt={alt.huntingGround}
          title={t(lang, "nav.huntingGround")}
          text={home.ways.huntingGround}
          href={localizedPath(lang, "/hunting-ground")}
        />
        <PhotoCard
          photo={photos.huntingTourism}
          alt={alt.huntingTourism}
          title={t(lang, "nav.huntingTourism")}
          text={home.ways.huntingTourism}
          href={localizedPath(lang, "/hunting-tourism")}
        />
        <PhotoCard
          photo={photos.huntingLodge}
          alt={alt.huntingLodge}
          title={t(lang, "nav.huntingLodge")}
          text={home.ways.huntingLodge}
          href={localizedPath(lang, "/hunting-lodge")}
        />
      </ul>
    </div>
  </section>

  <section class="section section-band on-dark" aria-labelledby="tourism">
    <div class="wrap split">
      <div>
        <p class="eyebrow">{t(lang, "nav.huntingTourism")}</p>
        <h2 id="tourism">{home.tourismHeading}</h2>
        <p>{home.tourismText}</p>
        {tourismLead && <p>{tourismLead}</p>}
        <div class="actions">
          <a class="button light" href={localizedPath(lang, "/hunting-tourism")}>{t(lang, "cta.tourismOffers")}</a>
          <a class="button outline-light" href={localizedPath(lang, "/contact")}>{t(lang, "cta.enquire")}</a>
        </div>
      </div>
      <div>
        <h3>{home.tourismSeasons}</h3>
        <ul class="checklist">
          {
            huntingTourism.seasons.map(({ species, season }) => (
              <li>
                <strong>{species}:</strong> {season}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="local">
    <div class="wrap">
      <h2 id="local">{home.localHeading}</h2>
      <ul class="duo">
        <li>
          <article class="card">
            <h3><a href={localizedPath(lang, "/game-damage")}>{t(lang, "nav.gameDamage")}</a></h3>
            <p>{home.local.gameDamage}</p>
          </article>
        </li>
        <li>
          <article class="card">
            <h3><a href={localizedPath(lang, "/membership")}>{t(lang, "nav.membership")}</a></h3>
            <p>{home.local.membership}</p>
          </article>
        </li>
      </ul>
    </div>
  </section>

  <section class="section section-alt" aria-labelledby="contact">
    <div class="wrap contact-band">
      <div>
        <h2 id="contact">{home.contactHeading}</h2>
        <p>{home.contactText}</p>
      </div>
      <ul class="contact-list">
        {
          contact.topics.map(({ email }) => (
            <li>
              {t(lang, "contact.email")}: <a href={`mailto:${email}`}>{email}</a>
            </li>
          ))
        }
        {
          contact.phone && (
            <li>
              {t(lang, "contact.phone")}: <a href={`tel:${contact.phone.replace(/\s/g, "")}`}>{contact.phone}</a>
            </li>
          )
        }
        <li>
          {`${texts.tourismContact.heading}: ${tourismReferent.name}, `}
          <a href={`tel:${tourismReferent.phone.replace(/\s/g, "")}`}>{tourismReferent.phone}</a>
        </li>
        <li>{`${company.address.street}, ${company.address.postalCode} ${company.address.city}`}</li>
        {
          contact.mapUrl && (
            <li>
              <a href={contact.mapUrl} rel="noopener noreferrer">{t(lang, "contact.map")}</a>
            </li>
          )
        }
      </ul>
    </div>
  </section>
</BaseLayout>
