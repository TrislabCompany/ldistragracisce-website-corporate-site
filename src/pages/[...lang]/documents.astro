---
// Documents to download, in groups (such as the forms for game damage). Each
// links to its file; a document without a file is not listed.
import DocumentList from "../../components/DocumentList.astro";
import { languagePaths, t, type Lang } from "../../i18n";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { pageTexts } from "../../lib/pages";

export const getStaticPaths = languagePaths;

const { lang } = Astro.props as { lang: Lang };
const { documents } = await pageTexts(lang);
---

<BaseLayout title={t(lang, "nav.documents")} description={documents.lead} lang={lang}>
  <div class="prose">
    <h1>{t(lang, "nav.documents")}</h1>
    <p class="lead">{documents.lead}</p>
    {
      documents.groups.map((group) => (
        <section class="document-group">
          <h2>{group.heading}</h2>
          <DocumentList documents={group.items} />
        </section>
      ))
    }
  </div>
</BaseLayout>
