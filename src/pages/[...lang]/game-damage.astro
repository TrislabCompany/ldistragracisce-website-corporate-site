---
// Game damage: who answers for it (game or a protected species), how to report
// it to the club step by step with the online report on eGozd, damage by protected species and on land where
// hunting is not allowed, how compensation is worked out, how to protect
// fields, and the sources (KGZS, Lovska zveza Slovenije).
import ContactCta from "../../components/ContactCta.astro";
import PhotoHead from "../../components/PhotoHead.astro";
import SourceList from "../../components/SourceList.astro";
import StepList from "../../components/StepList.astro";
import TextSections from "../../components/TextSections.astro";
import { languagePaths, localizedPath, t, type Lang } from "../../i18n";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { pageTexts } from "../../lib/pages";
import { photos } from "../../lib/photos";

export const getStaticPaths = languagePaths;

const { lang } = Astro.props as { lang: Lang };
const { gameDamage, alt, sourcesHeading } = await pageTexts(lang);
---

<BaseLayout title={t(lang, "nav.gameDamage")} description={gameDamage.lead} lang={lang} full>
  <PhotoHead photo={photos.gameDamage} alt={alt.gameDamage} title={t(lang, "nav.gameDamage")} lead={gameDamage.lead} />

  <section class="section" aria-labelledby="kinds">
    <div class="wrap">
      <div class="section-head">
        <h2 id="kinds">{gameDamage.kindsHeading}</h2>
        <p>{gameDamage.kindsIntro}</p>
      </div>
      <ul class="duo">
        {
          gameDamage.kinds.map((kind) => (
            <li>
              <article class="card">
                <h3>{kind.heading}</h3>
                <p>{kind.text}</p>
                <p>{kind.species}</p>
              </article>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="report">
    <div class="wrap prose">
      <h2 id="report">{gameDamage.reportHeading}</h2>
      <p>{gameDamage.reportIntro}</p>
      <StepList steps={gameDamage.steps} />
      <p>
        {gameDamage.formsText}{" "}
        <a href={localizedPath(lang, "/documents")}>{t(lang, "nav.documents")}</a>
      </p>
      <div class="online-report">
        <p>{gameDamage.egozd.text}</p>
        <a class="button" href={gameDamage.egozd.url}>{gameDamage.egozd.label}</a>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="protected">
    <div class="wrap prose">
      <h2 id="protected">{gameDamage.protectedHeading}</h2>
      <p>{gameDamage.protectedIntro}</p>
      <StepList steps={gameDamage.protectedSteps} />
      <div class="online-report">
        <p>{gameDamage.egozd.text}</p>
        <a class="button" href={gameDamage.egozd.url}>{gameDamage.egozd.label}</a>
      </div>
      <TextSections sections={[gameDamage.nonHunting]} />
    </div>
  </section>

  <section class="section" aria-labelledby="compensation">
    <div class="wrap prose">
      <h2 id="compensation">{gameDamage.compensationHeading}</h2>
      <p>{gameDamage.compensationIntro}</p>
      <ul class="checklist">
        {gameDamage.compensation.map((item) => <li>{item}</li>)}
      </ul>
      <p>{gameDamage.compensationNote}</p>
    </div>
  </section>

  <section class="section" aria-labelledby="protect">
    <div class="wrap prose">
      <h2 id="protect">{gameDamage.protectHeading}</h2>
      <p>{gameDamage.protectIntro}</p>
      <ul class="checklist">
        {gameDamage.measures.map((measure) => <li>{measure}</li>)}
      </ul>
      <p>{gameDamage.maintenance}</p>
      <p>{gameDamage.stewardship}</p>
      <SourceList heading={sourcesHeading} sources={gameDamage.sources} />
    </div>
    <div class="wrap">
      <ContactCta lang={lang} />
    </div>
  </section>
</BaseLayout>
